{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "version": "2.1.0",
  "default_locale": "en",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser@vaultrust.app",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/MStefa003/vault/releases/latest/download/firefox-updates.json",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_name__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["nativeMessaging", "storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["menu.html", "bar.html", "icons/icon-32.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+V" }
    },
    "fill-login": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "__MSG_commandFill__"
    }
  }
}
